generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  name         String?
  pictureUrl   String?
  role         String      @default("USER")
  ttsProvider  String      @default("kokoro")
  ttsVoice     String      @default("af_heart")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]
  feedTokens   FeedToken[]
  shareTokens  ShareToken[]
  items        Item[]
  oauthIdentities OAuthIdentity[]
  extensionConnectCodes ExtensionConnectCode[]
  extensionTokens ExtensionToken[]
  demoExtractionTraces DemoExtractionTrace[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedToken {
  id        String   @id @default(cuid())
  userId    String
  tokenValue String  @unique
  tokenHash String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  rotatedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model ShareToken {
  id        String   @id @default(cuid())
  userId    String
  tokenValue String  @unique
  tokenHash String   @unique
  scope     String   @default("read_only")
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id            String      @id @default(cuid())
  userId        String
  title         String?
  sourceType    String
  sourceUrl     String?
  sourceFilePath String?
  sourceHtml    String?
  sourceCapturedAt DateTime?
  status        String      @default("QUEUED")
  errorCode     String?
  errorMessage  String?
  textHash      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]
  jobEvents     JobEvent[]
  episode       Episode?
  artifacts     ItemArtifact[]
  chunkCaches   ChunkCache[]
  demoExtractionTrace DemoExtractionTrace?

  @@index([userId, status])
}

model ItemArtifact {
  id          String   @id @default(cuid())
  itemId      String
  kind        String
  storageKey  String
  contentType String
  byteLength  Int
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, kind])
  @@index([kind, createdAt])
  @@index([expiresAt])
}

model OAuthIdentity {
  id            String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  emailAtLink    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, provider])
}

model ExtensionConnectCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String   @unique
  label      String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExtensionToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  tokenValue String   @unique
  label      String?
  scope      String   @default("ingest:html_snapshot")
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Episode {
  id          String   @id @default(cuid())
  itemId       String   @unique
  guid         String   @unique
  title        String
  description  String
  audioPath    String
  audioBytes   Int
  mimeType     String
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

model Job {
  id          String    @id @default(cuid())
  itemId      String
  attempt     Int       @default(0)
  status      String    @default("QUEUED")
  lockedAt    DateTime?
  nextRetryAt DateTime?
  errorCode   String?
  errorMessage String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  events      JobEvent[]

  @@index([status, createdAt])
}

model JobEvent {
  id         String   @id @default(cuid())
  jobId       String
  itemId      String
  stage       String
  eventType   String
  payloadJson Json
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ChunkCache {
  id         String   @id @default(cuid())
  itemId      String
  chunkIndex  Int
  hash        String   @unique
  filePath    String
  audioBytes  Int
  mimeType    String
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model DemoExtractionTrace {
  id               String   @id @default(cuid())
  userId           String
  itemId           String   @unique
  sourceLabel      String
  extractedText    String
  extractedMarkdown String?
  extractionLogJson Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
