generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  name         String?
  role         String      @default("USER")
  isPaid       Boolean     @default(false)
  submissionCount Int      @default(0)
  extraSubmissionCredits Int @default(0)
  ttsProvider  String      @default("kokoro")
  ttsVoice     String      @default("af_heart")
  firstSeenAt  DateTime?
  firstSeenCountryCode String?
  firstSeenRegionCode String?
  firstSeenCity String?
  lastSeenAt   DateTime?
  lastSeenCountryCode String?
  lastSeenRegionCode String?
  lastSeenCity String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]
  feedTokens   FeedToken[]
  shareTokens  ShareToken[]
  items        Item[]
  oauthIdentities OAuthIdentity[]
  extensionConnectCodes ExtensionConnectCode[]
  extensionTokens ExtensionToken[]
  demoExtractionTraces DemoExtractionTrace[]
  analyticsEvents AnalyticsEvent[]
  digestSettings UserDigestSettings?
  digestFeedTokens DigestFeedToken[]
  digestRuns      DigestRun[]
  digestEpisodes  DigestEpisode[]
  demographicSurvey UserDemographicSurvey?
  feedbackSubmissions UserFeedback[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedToken {
  id        String   @id @default(cuid())
  userId    String
  tokenValue String?  @unique
  tokenHash String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  rotatedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model ShareToken {
  id        String   @id @default(cuid())
  userId    String
  tokenValue String?  @unique
  tokenHash String   @unique
  scope     String   @default("read_only")
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id            String      @id @default(cuid())
  userId        String
  title         String?
  sourceType    String
  sourceUrl     String?
  sourceFilePath String?
  sourceHtml    String?
  sourceCapturedAt DateTime?
  status        String      @default("QUEUED")
  errorCode     String?
  errorMessage  String?
  textHash      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          Job[]
  jobEvents     JobEvent[]
  episode       Episode?
  artifacts     ItemArtifact[]
  chunkCaches   ChunkCache[]
  demoExtractionTrace DemoExtractionTrace?
  analyticsEvents AnalyticsEvent[]

  @@index([userId, status])
}

model ItemArtifact {
  id          String   @id @default(cuid())
  itemId      String
  kind        String
  storageKey  String
  contentType String
  byteLength  Int
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, kind])
  @@index([kind, createdAt])
  @@index([expiresAt])
}

model OAuthIdentity {
  id            String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  emailAtLink    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId, provider])
}

model ExtensionConnectCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String   @unique
  label      String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ExtensionToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  tokenValue String?   @unique
  label      String?
  scope      String   @default("ingest:html_snapshot")
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Episode {
  id          String   @id @default(cuid())
  itemId       String   @unique
  guid         String   @unique
  title        String
  description  String
  audioPath    String
  audioBytes   Int
  mimeType     String
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

model Job {
  id          String    @id @default(cuid())
  itemId      String
  attempt     Int       @default(0)
  status      String    @default("QUEUED")
  lockedAt    DateTime?
  nextRetryAt DateTime?
  errorCode   String?
  errorMessage String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  events      JobEvent[]

  @@index([status, createdAt])
}

model JobEvent {
  id         String   @id @default(cuid())
  jobId       String
  itemId      String
  stage       String
  eventType   String
  payloadJson Json
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ChunkCache {
  id         String   @id @default(cuid())
  itemId      String
  chunkIndex  Int
  hash        String   @unique
  filePath    String
  audioBytes  Int
  mimeType    String
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model DemoExtractionTrace {
  id               String   @id @default(cuid())
  userId           String
  itemId           String   @unique
  sourceLabel      String
  extractedText    String
  extractedMarkdown String?
  extractionLogJson Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  eventType     String
  occurredAt    DateTime
  day           String
  userId        String?
  itemId        String?
  sourceType    String?
  authMethod    String?
  userRole      String?
  segmentAuth   String?
  metadataJson  Json?
  dedupeKey     String   @unique
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  item          Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([occurredAt, eventType])
  @@index([day, eventType])
  @@index([userId, day])
  @@index([itemId, day])
}

model AnalyticsDailyRollup {
  id                          String   @id @default(cuid())
  day                         String
  segmentKey                  String
  signups                     Int      @default(0)
  logins                      Int      @default(0)
  submissions                 Int      @default(0)
  ready                       Int      @default(0)
  failed                      Int      @default(0)
  playbackStarts              Int      @default(0)
  processingDurationMsTotal   Int      @default(0)
  processingDurationSamples   Int      @default(0)
  queueWaitDurationMsTotal    Int      @default(0)
  queueWaitDurationSamples    Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([day, segmentKey])
  @@index([day])
}

model AnalyticsCoverage {
  id              String   @id @default(cuid())
  metricKey       String   @unique
  coverageStartAt DateTime
  isBackfilled    Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserDigestSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  timezone            String   @default("UTC")
  dailyEmailEnabled   Boolean  @default(false)
  dailyPodcastEnabled Boolean  @default(false)
  dailyHour           Int      @default(16)
  dailyMinute         Int      @default(0)
  dailyLengthMinutes  Int      @default(5)
  dailyNextRunAt      DateTime?
  weeklyEmailEnabled  Boolean  @default(true)
  weeklyPodcastEnabled Boolean @default(true)
  weeklyDayOfWeek     Int      @default(5)
  weeklyHour          Int      @default(16)
  weeklyMinute        Int      @default(0)
  weeklyLengthMinutes Int      @default(15)
  weeklyNextRunAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dailyNextRunAt])
  @@index([weeklyNextRunAt])
}

model DigestFeedToken {
  id         String   @id @default(cuid())
  userId     String
  tokenValue String?   @unique
  tokenHash  String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  rotatedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model DigestRun {
  id                  String   @id @default(cuid())
  userId              String
  cadence             String
  periodKey           String
  windowStart         DateTime
  windowEnd           DateTime
  scheduledFor        DateTime
  status              String   @default("QUEUED")
  attempt             Int      @default(0)
  lockedAt            DateTime?
  nextRetryAt         DateTime?
  targetLengthMinutes Int
  sourceItemCount     Int      @default(0)
  summaryStorageKey   String?
  summaryBytes        Int?
  emailEnabled        Boolean  @default(false)
  emailStatus         String?
  emailSubject        String?
  emailStorageKey     String?
  emailError          String?
  podcastEnabled      Boolean  @default(false)
  podcastStatus       String?
  podcastError        String?
  errorCode           String?
  errorMessage        String?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode DigestEpisode?

  @@unique([userId, cadence, periodKey])
  @@index([status, scheduledFor])
  @@index([status, nextRetryAt])
  @@index([userId, createdAt])
}

model DigestEpisode {
  id         String   @id @default(cuid())
  digestRunId String  @unique
  userId     String
  guid       String   @unique
  title      String
  description String
  audioPath  String
  audioBytes Int
  mimeType   String
  publishedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  digestRun DigestRun @relation(fields: [digestRunId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt])
}

model DigestSchedulerTick {
  id          String   @id @default(cuid())
  requestedAt DateTime @default(now())
  requestedBy String
  forceNow    Boolean  @default(false)
  processedAt DateTime?

  @@index([processedAt, requestedAt])
  @@index([requestedAt])
}

model UserDemographicSurvey {
  id                 String   @id @default(cuid())
  userId             String   @unique
  status             String   @default("PENDING")
  ageBand            String?
  genderIdentity     String?
  genderSelfDescribe String?
  completedAt        DateTime?
  skippedAt          DateTime?
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model UserFeedback {
  id                String   @id @default(cuid())
  userId            String
  message           String
  feedbackType      String?
  featureArea       String?
  allowEmailContact Boolean  @default(true)
  status            String   @default("NEW")
  sourcePath        String?
  mirrorStatus      String   @default("PENDING")
  mirrorIssueNumber Int?
  mirrorIssueUrl    String?
  mirrorAttemptedAt DateTime?
  mirrorErrorCode   String?
  mirrorErrorMessage String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([mirrorStatus, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}
