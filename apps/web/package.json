{
  "name": "@articlepod/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate:ensure && next build",
    "start": "npm run prisma:generate:ensure && next start",
    "lint": "npm run prisma:generate:ensure && next lint",
    "typecheck": "npm run prisma:generate:ensure && tsc --noEmit",
    "test": "DATABASE_URL=file:${PWD}/.data/db.sqlite npm run prisma:generate:ensure && DATABASE_URL=file:${PWD}/.data/db.sqlite npm run db:bootstrap && DATABASE_URL=file:${PWD}/.data/db.sqlite ARTICLEPOD_TEST_DB_READY=1 tsx --test tests/**/*.test.ts",
    "test:observability": "DATABASE_URL=file:${PWD}/.data/db.sqlite npm run prisma:generate:ensure && DATABASE_URL=file:${PWD}/.data/db.sqlite npm run db:bootstrap && DATABASE_URL=file:${PWD}/.data/db.sqlite ARTICLEPOD_TEST_DB_READY=1 tsx --test tests/observability.test.ts tests/admin-analytics.test.ts tests/admin-analytics-azure-primary.test.ts",
    "test:e2e": "npx playwright test --config=playwright.config.ts",
    "export": "npm run prisma:generate:ensure && tsx scripts/export.ts",
    "seed:demo": "if [ -f ../../.env ]; then tsx --env-file=../../.env scripts/seed-demo.ts; else tsx scripts/seed-demo.ts; fi",
    "tts:precompute": "tsx scripts/precompute-tts-previews.ts",
    "db:bootstrap": "npm run prisma:generate:ensure && tsx scripts/bootstrap-db.ts",
    "db:export-json": "tsx scripts/db-export-json.ts",
    "db:import-json": "tsx scripts/db-import-json.ts",
    "user:mirror-from-azure": "tsx scripts/mirror-user-from-azure.ts",
    "ops:snapshot": "tsx scripts/ops-snapshot.ts",
    "ops:extraction-selection-report": "tsx scripts/extraction-selection-report.ts",
    "ops:verify-restore": "tsx scripts/ops-verify-restore.ts",
    "artifacts:backfill": "tsx scripts/backfill-markdown-artifacts.ts",
    "artifacts:migrate-layout": "tsx scripts/migrate-markdown-storage-layout.ts",
    "artifacts:cleanup-markdown": "tsx scripts/cleanup-markdown-artifacts.ts",
    "artifacts:purge": "tsx scripts/purge-expired-artifacts.ts",
    "audio:backfill-mp3": "tsx scripts/backfill-episode-audio.ts",
    "audio:backfill-retention": "tsx scripts/backfill-audio-retention.ts",
    "analytics:backfill": "tsx scripts/backfill-admin-analytics.ts",
    "metadata:backfill": "tsx scripts/metadata-backfill-table.ts",
    "metadata:check": "tsx scripts/metadata-consistency-check.ts",
    "wiki:prepare": "tsx scripts/wiki-prepare.ts",
    "wiki:publish": "tsx scripts/wiki-publish.ts",
    "wiki:lint": "tsx scripts/wiki-lint.ts",
    "wiki:verify": "tsx scripts/wiki-verify.ts",
    "prisma:generate": "node ../../scripts/prisma-profile.mjs generate",
    "prisma:generate:ensure": "node ../../scripts/ensure-prisma-generated.mjs",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/storage-blob": "^12.31.0",
    "@articlepod/core": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.18",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.14",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
