{
  "name": "@articlepod/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "npm run prisma:generate && next start",
    "lint": "npm run prisma:generate && next lint",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "test": "DATABASE_URL=file:${PWD}/.data/db.sqlite npm run prisma:generate && DATABASE_URL=file:${PWD}/.data/db.sqlite npm run db:bootstrap && DATABASE_URL=file:${PWD}/.data/db.sqlite ARTICLEPOD_TEST_DB_READY=1 tsx --test tests/**/*.test.ts",
    "export": "tsx scripts/export.ts",
    "seed:demo": "if [ -f ../../.env ]; then tsx --env-file=../../.env scripts/seed-demo.ts; else tsx scripts/seed-demo.ts; fi",
    "tts:precompute": "tsx scripts/precompute-tts-previews.ts",
    "db:bootstrap": "tsx scripts/bootstrap-db.ts",
    "db:export-json": "tsx scripts/db-export-json.ts",
    "db:import-json": "tsx scripts/db-import-json.ts",
    "ops:snapshot": "tsx scripts/ops-snapshot.ts",
    "ops:verify-restore": "tsx scripts/ops-verify-restore.ts",
    "artifacts:backfill": "tsx scripts/backfill-markdown-artifacts.ts",
    "artifacts:purge": "tsx scripts/purge-expired-artifacts.ts",
    "analytics:backfill": "tsx scripts/backfill-admin-analytics.ts",
    "prisma:generate": "node ../../scripts/prisma-profile.mjs generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@articlepod/core": "workspace:*",
    "@prisma/client": "6.2.1",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "next": "14.2.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.24",
    "postcss": "^8",
    "prisma": "6.2.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
