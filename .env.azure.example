# Azure profile (single VM compute + managed PostgreSQL + Azure Blob)
RUNTIME_PROFILE="azure"
DATABASE_URL="postgresql://articlepod_admin:<password>@<host>:5432/articlepod?sslmode=require"
APP_URL="https://<your-app-domain>"
NEXT_PUBLIC_CONTACT_EMAIL=""

STORAGE_BACKEND="azure_blob"
AZURE_STORAGE_CONTAINER="articlepod"
AZURE_STORAGE_CREATE_CONTAINER="1"

# Option 1: connection string
AZURE_STORAGE_CONNECTION_STRING=""

# Option 2: account URL + SAS
AZURE_STORAGE_ACCOUNT_URL=""
AZURE_STORAGE_SAS_TOKEN=""
ITEM_DISPATCH_BACKEND="azure_queue"
ITEM_DISPATCH_QUEUE_NAME="articlepod-item-dispatch"
ITEM_DISPATCH_CREATE_QUEUE="1"
ITEM_DISPATCH_VISIBILITY_MS="900000"
ITEM_DISPATCH_HEARTBEAT_MS="30000"
ITEM_DISPATCH_MAX_DELIVERIES="8"
WORKER_INSTANCE_ID=""

PYTHON_TTS_URL="http://127.0.0.1:8010"
# Azure B2s hosts can take well over 2 minutes for long Kokoro chunks.
PYTHON_TTS_TIMEOUT_MS="300000"
PINNED_FETCH_IPV6_ENABLED="0"
WORKER_ROLE="primary"
WORKER_OVERFLOW_ENABLED="0"
WORKER_OVERFLOW_POLICY_EVAL_MS="15000"
WORKER_OVERFLOW_ACTIVATE_QUEUE_DEPTH="8"
WORKER_OVERFLOW_DEACTIVATE_QUEUE_DEPTH="2"
WORKER_OVERFLOW_ACTIVATE_OLDEST_MS="300000"
WORKER_OVERFLOW_DEACTIVATE_OLDEST_MS="120000"
WORKER_OVERFLOW_MIN_ACTIVE_MS="180000"
OVERFLOW_PYTHON_TTS_URL=""
OVERFLOW_PYTHON_TTS_TIMEOUT_MS="300000"
OVERFLOW_PYTHON_TTS_SECRET=""
WORKER_STALE_PROCESSING_MS="900000"
WORKER_MAX_STALE_RETRIES="1"
WORKER_MAX_PROCESSING_MS="2700000"
WORKER_RAW_ARTIFACT_RETENTION_DAYS="90"
DIGEST_INTERNAL_SCHEDULER_ENABLED="1"
DIGEST_SCHEDULER_TICK_MS="60000"
DIGEST_SCHEDULER_SECRET=""
DIGEST_RUN_MAX_RETRY_ATTEMPTS="3"
DIGEST_SUMMARY_PROVIDER="azure_openai"
DIGEST_SUMMARY_PROXY_URL=""
DIGEST_SUMMARY_TIMEOUT_MS="30000"
AZURE_OPENAI_BASE_URL=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_SUMMARY_NANO_DEPLOYMENT="digest-summary-nano"
AZURE_OPENAI_SUMMARY_MINI_DEPLOYMENT="digest-summary-mini"
DIGEST_EMAIL_PROVIDER="stub"
LOG_RETENTION_DAYS="7"
LOG_ERROR_RETENTION_DAYS="30"
LOG_MAX_BYTES="1048576"
LOG_MAX_FILES="10"
ARTICLEPOD_CONSOLE_LOGS="0"
PODCAST_REQUEST_LOGGING="1"
ANALYTICS_STORAGE_MODE="full"
JOB_EVENT_STORAGE_MODE="database"
DEMO_EXTRACTION_TRACE_ENABLED="1"
VM_JOURNAL_MAX_USE="200M"
VM_JOURNAL_KEEP_FREE="1G"
VM_JOURNAL_RETENTION="7day"
VM_CLEANUP_MIN_FREE_MB="3072"

DEMO_EMAIL="demo@articlepod.local"
ADMIN_EMAIL="admin@articlepod.local"
ADMIN_PASSWORD="admin-demo-password"
FREE_TRIAL_SUBMISSION_LIMIT="2"
PRO_MONTHLY_DAILY_PODCAST_LIMIT="12"
PRO_MONTHLY_DAILY_SUMMARY_LIMIT="36"
PRO_MONTHLY_WEEKLY_SUMMARY_LIMIT="15"
PRO_ANNUAL_DAILY_PODCAST_LIMIT="15"
PRO_ANNUAL_DAILY_SUMMARY_LIMIT="45"
PRO_ANNUAL_WEEKLY_SUMMARY_LIMIT="30"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
GEO_HEADER_COUNTRY=""
GEO_HEADER_REGION=""
GEO_HEADER_CITY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# Deploy helper ingress/TLS automation (optional for local shell + CI convenience)
CANONICAL_HOST="articlepod.com"
HOST_ALIASES="www.articlepod.com"
LETSENCRYPT_EMAIL=""
APP_DOMAIN_ALIASES="www.articlepod.com"
