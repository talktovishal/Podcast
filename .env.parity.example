# Parity profile — PostgreSQL + Azurite (Docker Compose local dev / CI)
# Copy to .env and set real passwords before running.
RUNTIME_PROFILE="parity"
DATABASE_URL="postgresql://articlepod:articlepod@127.0.0.1:5432/articlepod"
APP_URL="http://localhost:3000"
STORAGE_BACKEND="azure_blob"
AZURE_STORAGE_CONTAINER="articlepod"
AZURE_STORAGE_CREATE_CONTAINER="1"
# Azurite well-known local emulator key — not a real credential
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
PYTHON_TTS_URL="http://127.0.0.1:8010"
PYTHON_TTS_TIMEOUT_MS="120000"

# Demo/admin — replace with real passwords before seeding
DEMO_EMAIL="demo@articlepod.local"
DEMO_PASSWORD="local-dev-demo"
ADMIN_EMAIL="admin@articlepod.local"
ADMIN_PASSWORD="local-dev-admin"

WORKER_STALE_PROCESSING_MS="180000"
LOG_MAX_BYTES="1048576"
LOG_MAX_FILES="10"
EXTENSION_CONNECT_CODE_TTL_MINUTES="10"
EXTENSION_TOKEN_TTL_DAYS="30"

# Optional providers
# --- Google OAuth Setup ---
# 1. Go to https://console.cloud.google.com/ and create a project (or select an existing one).
# 2. Enable the "Google+ API" or "Google Identity" OAuth 2.0 service.
# 3. Under "APIs & Services" > "Credentials", create an OAuth 2.0 Client ID (Application type: Web application).
# 4. Add your domain to "Authorized JavaScript origins" (e.g. https://yourdomain.com).
# 5. Add the callback URL to "Authorized redirect URIs": <APP_URL>/api/auth/google/callback
# 6. Copy the Client ID and Client Secret below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# --- Apple OAuth Setup ---
# 1. Go to https://developer.apple.com/ > Certificates, Identifiers & Profiles > Identifiers.
# 2. Register a Services ID (not App ID) and enable "Sign In with Apple".
# 3. Configure the return URL: <APP_URL>/api/auth/apple/callback
# 4. Generate a private key under "Keys" with "Sign In with Apple" enabled.
# 5. The APPLE_CLIENT_ID is your Services ID; APPLE_CLIENT_SECRET is the generated private key.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
