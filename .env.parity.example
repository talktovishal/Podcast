# Parity profile — PostgreSQL + Azurite (Docker Compose local dev / CI)
# Copy to .env and set real passwords before running.
RUNTIME_PROFILE="parity"
DATABASE_URL="postgresql://articlepod:articlepod@127.0.0.1:5432/articlepod"
APP_URL="http://localhost:3000"
STORAGE_BACKEND="azure_blob"
AZURE_STORAGE_CONTAINER="articlepod"
AZURE_STORAGE_CREATE_CONTAINER="1"
# Azurite well-known local emulator key — not a real credential
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
PYTHON_TTS_URL="http://127.0.0.1:8010"
PYTHON_TTS_TIMEOUT_MS="120000"
TTS_WORKERS="1"
METADATA_PRIMARY_BACKEND="prisma"
METADATA_MIRROR_BACKEND="none"
METADATA_MIRROR_DUAL_WRITE="0"
METADATA_CANARY_COMPARE="0"
WORKER_QUEUE_PRESSURE_SOURCE="prisma"
AZURE_TABLE_CONNECTION_STRING=""
AZURE_TABLE_ACCOUNT_URL=""
AZURE_TABLE_SAS_TOKEN=""
AZURE_TABLE_PREFIX="articlepod"
AZURE_TABLE_CREATE_TABLES="1"
WORKER_ROLE="primary"
WORKER_OVERFLOW_ENABLED="0"
WORKER_OVERFLOW_POLICY_EVAL_MS="15000"
WORKER_OVERFLOW_ACTIVATE_QUEUE_DEPTH="8"
WORKER_OVERFLOW_DEACTIVATE_QUEUE_DEPTH="2"
WORKER_OVERFLOW_ACTIVATE_OLDEST_MS="300000"
WORKER_OVERFLOW_DEACTIVATE_OLDEST_MS="120000"
WORKER_OVERFLOW_MIN_ACTIVE_MS="180000"
OVERFLOW_PYTHON_TTS_URL=""
OVERFLOW_PYTHON_TTS_TIMEOUT_MS="120000"
OVERFLOW_PYTHON_TTS_SECRET=""
DIGEST_INTERNAL_SCHEDULER_ENABLED="1"
DIGEST_SCHEDULER_TICK_MS="60000"
DIGEST_SCHEDULER_SECRET="parity-digest-scheduler-secret"
MEDIA_SIGNING_KEY="parity-media-signing-key-32-bytes"
DIGEST_RUN_MAX_RETRY_ATTEMPTS="3"
DIGEST_SUMMARY_PROVIDER="stub"
DIGEST_SUMMARY_PROXY_URL=""
DIGEST_SUMMARY_TIMEOUT_MS="30000"
AZURE_OPENAI_BASE_URL=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_SUMMARY_NANO_DEPLOYMENT="digest-summary-nano"
AZURE_OPENAI_SUMMARY_MINI_DEPLOYMENT="digest-summary-mini"
DIGEST_EMAIL_PROVIDER="stub"

# Demo/admin — replace with real passwords before seeding
DEMO_EMAIL="demo@articlepod.local"
DEMO_PASSWORD="local-dev-demo"
ADMIN_EMAIL="admin@articlepod.local"
ADMIN_PASSWORD="local-dev-admin"
FREE_TRIAL_SUBMISSION_LIMIT="2"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
GEO_HEADER_COUNTRY=""
GEO_HEADER_REGION=""
GEO_HEADER_CITY=""

WORKER_STALE_PROCESSING_MS="180000"
LOG_MAX_BYTES="1048576"
LOG_MAX_FILES="10"
ANALYTICS_STORAGE_MODE="full"
JOB_EVENT_STORAGE_MODE="database"
DEMO_EXTRACTION_TRACE_ENABLED="1"
EXTENSION_CONNECT_CODE_TTL_MINUTES="1440"
GITHUB_FEEDBACK_MIRROR_ENABLED="0"
GITHUB_FEEDBACK_OWNER=""
GITHUB_FEEDBACK_REPO=""
GITHUB_FEEDBACK_TOKEN=""
GITHUB_FEEDBACK_LABELS="feedback"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""
