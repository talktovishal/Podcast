# Simple profile — SQLite + local object storage (local dev / CI)
# Copy to .env and set real passwords before running.
RUNTIME_PROFILE="simple"
DATABASE_URL="file:./apps/web/.data/db.sqlite"
APP_URL="http://localhost:3000"
STORAGE_BACKEND="local"
STORAGE_ROOT="./apps/web/.data/media"
MEDIA_ROOT="./apps/web/.data/media"
UPLOAD_ROOT="./apps/web/.data/uploads"

# Demo/admin — replace with real passwords before seeding
DEMO_EMAIL="demo@articlepod.local"
DEMO_PASSWORD="local-dev-demo"
ADMIN_EMAIL="admin@articlepod.local"
ADMIN_PASSWORD="local-dev-admin"
FREE_TRIAL_SUBMISSION_LIMIT="2"

# Optional providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
GEO_HEADER_COUNTRY=""
GEO_HEADER_REGION=""
GEO_HEADER_CITY=""
OPENAI_API_KEY=""
PYTHON_TTS_URL="http://127.0.0.1:8010"
PYTHON_TTS_TIMEOUT_MS="120000"
WORKER_STALE_PROCESSING_MS="180000"
DIGEST_INTERNAL_SCHEDULER_ENABLED="1"
DIGEST_SCHEDULER_TICK_MS="60000"
DIGEST_SCHEDULER_SECRET="local-digest-scheduler-secret"
DIGEST_RUN_MAX_RETRY_ATTEMPTS="3"
DIGEST_SUMMARY_PROVIDER="stub"
DIGEST_SUMMARY_PROXY_URL=""
DIGEST_SUMMARY_TIMEOUT_MS="30000"
DIGEST_EMAIL_PROVIDER="stub"
LOG_MAX_BYTES="1048576"
LOG_MAX_FILES="10"
EXTENSION_CONNECT_CODE_TTL_MINUTES="10"
EXTENSION_TOKEN_TTL_DAYS="30"
