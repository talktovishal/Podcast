[Unit]
Description=ArticlePod Python TTS Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=articlepod
Group=articlepod
WorkingDirectory=/opt/articlepod/services/python-tts
EnvironmentFile=/etc/articlepod/articlepod.env
ExecStart=/usr/bin/env bash -lc 'cd /opt/articlepod/services/python-tts && ./.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010'
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
Alias=listenlater-python-tts.service
