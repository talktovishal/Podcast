[Unit]
Description=ArticlePod Python TTS Service
After=network.target
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=articlepod
Group=articlepod
WorkingDirectory=/opt/articlepod/services/python-tts
EnvironmentFile=/etc/articlepod/articlepod.env
# Cost-optimized default locks local TTS lane to a single worker on B2s.
ExecStart=/usr/bin/env bash /opt/articlepod/scripts/azure/runtime-exec.sh python-tts /usr/bin/env bash -lc 'cd /opt/articlepod/services/python-tts && ./.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1'
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
Alias=listenlater-python-tts.service
