[Unit]
Description=ArticlePod Overflow Worker
After=network.target articlepod-python-tts.service
Wants=network.target

[Service]
Type=simple
User=articlepod
Group=articlepod
WorkingDirectory=/opt/articlepod
EnvironmentFile=/etc/articlepod/articlepod.env
Environment=WORKER_ROLE=overflow
Environment=WORKER_OVERFLOW_ENABLED=1
ExecStartPre=/usr/bin/env bash /opt/articlepod/scripts/azure/runtime-exec.sh worker-overflow --env-file /etc/articlepod/articlepod.env --public-only --shell 'cd /opt/articlepod/apps/worker && export RUNTIME_PROFILE=azure && npm run prisma:generate:ensure'
ExecStart=/usr/bin/env bash /opt/articlepod/scripts/azure/runtime-exec.sh worker-overflow --env-file /etc/articlepod/articlepod.env --shell 'cd /opt/articlepod/apps/worker && export RUNTIME_PROFILE=azure && exec ./node_modules/.bin/tsx src/index.ts'
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
