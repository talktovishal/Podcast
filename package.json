{
  "name": "listenlater",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "export": "npx pnpm --filter @listenlater/web run export",
    "seed:demo": "npx pnpm --filter @listenlater/web run seed:demo",
    "check:env": "node scripts/check-env.mjs",
    "check:env:simple": "node scripts/check-env.mjs --profile simple",
    "check:env:parity": "node scripts/check-env.mjs --profile parity",
    "check:env:azure": "node scripts/check-env.mjs --profile azure",
    "license:check": "node scripts/license-check.mjs",
    "test:tts:e2e": "./scripts/test-python-tts-e2e.sh",
    "parity:up": "./scripts/parity-up.sh",
    "parity:down": "./scripts/parity-down.sh",
    "parity:smoke": "./scripts/parity-smoke.sh",
    "azure:deploy:changes": "./scripts/azure/deploy-changes.sh",
    "db:migrate:sqlite-to-postgres": "./scripts/migrate-sqlite-to-postgres.sh",
    "ops:pre-drill-snapshot": "./scripts/ops/pre-drill-snapshot.sh",
    "ops:verify-restore": "./scripts/ops/verify-restore.sh",
    "artifacts:backfill": "npx pnpm --filter @listenlater/web run artifacts:backfill",
    "artifacts:purge": "npx pnpm --filter @listenlater/web run artifacts:purge",
    "extension:icons": "python3 scripts/generate-extension-icons.py",
    "extension:package": "./scripts/package-extension.sh",
    "logs:collect": "node scripts/logs-collect.mjs",
    "logs:triage": "node scripts/logs-triage.mjs",
    "observability:verify": "node scripts/observability-verify.mjs",
    "costs:refresh-prices": "node scripts/cost-model/fetch-azure-prices.mjs",
    "costs:build": "node scripts/cost-model/build-all.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "exceljs": "^4.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
