{
  "name": "articlepod",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "testing/*"
  ],
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web-only",
    "dev:fast": "node scripts/dev.mjs --fast",
    "dev:web:fast": "node scripts/dev.mjs --web-only --fast",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npx pnpm --filter @articlepod/web run test:e2e",
    "format": "prettier --write .",
    "export": "npx pnpm --filter @articlepod/web run export",
    "seed:demo": "npx pnpm --filter @articlepod/web run seed:demo",
    "check:env": "node scripts/check-env.mjs",
    "check:env:simple": "node scripts/check-env.mjs --profile simple",
    "check:env:parity": "node scripts/check-env.mjs --profile parity",
    "check:env:azure": "node scripts/check-env.mjs --profile azure",
    "naming:sync": "node scripts/naming/sync.mjs",
    "naming:check": "node scripts/naming/check.mjs",
    "license:check": "node scripts/license-check.mjs",
    "test:tts:e2e": "./scripts/test-python-tts-e2e.sh",
    "parity:up": "./scripts/parity-up.sh",
    "parity:down": "./scripts/parity-down.sh",
    "parity:smoke": "./scripts/parity-smoke.sh",
    "azure:deploy:changes": "./scripts/azure/deploy-changes.sh",
    "db:migrate:sqlite-to-postgres": "./scripts/migrate-sqlite-to-postgres.sh",
    "ops:pre-drill-snapshot": "./scripts/ops/pre-drill-snapshot.sh",
    "ops:verify-restore": "./scripts/ops/verify-restore.sh",
    "ops:cost-baseline": "./scripts/ops/cost-baseline-snapshot.sh",
    "ops:azure-cost-report": "python3 scripts/azure/cost-report.py",
    "artifacts:backfill": "npx pnpm --filter @articlepod/web run artifacts:backfill",
    "artifacts:migrate-layout": "npx pnpm --filter @articlepod/web run artifacts:migrate-layout",
    "artifacts:cleanup-markdown": "npx pnpm --filter @articlepod/web run artifacts:cleanup-markdown",
    "artifacts:purge": "npx pnpm --filter @articlepod/web run artifacts:purge",
    "audio:backfill-mp3": "npx pnpm --filter @articlepod/web run audio:backfill-mp3",
    "analytics:backfill": "npx pnpm --filter @articlepod/web run analytics:backfill",
    "metadata:backfill": "npx pnpm --filter @articlepod/web run metadata:backfill",
    "metadata:check": "npx pnpm --filter @articlepod/web run metadata:check",
    "extension:icons": "python3 scripts/generate-extension-icons.py",
    "extension:package:raw": "./scripts/package-extension.sh",
    "extension:package": "node scripts/extension-release-check.mjs",
    "extension:validate": "node scripts/validate-extension.mjs --zip",
    "extension:smoke:package": "corepack pnpm --filter @articlepod/live-site exec tsx ../../scripts/extension-packaged-smoke.mjs",
    "extension:release:check": "corepack pnpm extension:package && corepack pnpm extension:smoke:package",
    "live-sites:test": "npx pnpm --filter @articlepod/live-site run live-sites:test",
    "live-sites:test:url": "npx pnpm --filter @articlepod/live-site run live-sites:test:url",
    "live-sites:test:extension": "npx pnpm --filter @articlepod/live-site run live-sites:test:extension",
    "live-sites:test:prod-probe": "npx pnpm --filter @articlepod/live-site run live-sites:test:prod-probe",
    "extraction-quality:audit": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:audit",
    "extraction-quality:audit:prod": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:audit:prod",
    "extraction-quality:test": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:test",
    "extraction-quality:test:defuddle": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:test:defuddle",
    "extraction-quality:test:url": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:test:url",
    "extraction-quality:test:extension": "npx pnpm --filter @articlepod/extraction-quality run extraction-quality:test:extension",
    "logs:collect": "node scripts/logs-collect.mjs",
    "logs:triage": "node scripts/logs-triage.mjs",
    "observability:verify": "node scripts/observability-verify.mjs",
    "costs:refresh-prices": "node scripts/cost-model/fetch-azure-prices.mjs",
    "costs:build": "node scripts/cost-model/build-all.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "exceljs": "^4.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
