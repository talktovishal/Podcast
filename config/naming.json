{
  "brand": {
    "name": "ArticlePod",
    "slug": "articlepod",
    "legacySlug": "listenlater",
    "botUserAgent": "ArticlePodBot/0.1 (+https://articlepod.com)",
    "snapshotFallbackUrl": "https://snapshot.articlepod.local/",
    "defaultDemoEmail": "demo@articlepod.local",
    "defaultAdminEmail": "admin@articlepod.local"
  },
  "packages": {
    "scope": "@articlepod",
    "legacyScope": "@listenlater"
  },
  "auth": {
    "sessionCookie": "articlepod_session",
    "oauthCookiePrefix": "articlepod_oauth_state",
    "legacySessionCookie": "listenlater_session",
    "legacyOauthCookiePrefix": "listenlater_oauth_state"
  },
  "extension": {
    "storageKeys": {
      "serverUrl": "articlepod_server_url",
      "extensionToken": "articlepod_extension_token",
      "tokenExpiresAt": "articlepod_extension_token_expires_at"
    },
    "legacyStorageKeys": {
      "serverUrl": "listenlater_server_url",
      "extensionToken": "listenlater_extension_token",
      "tokenExpiresAt": "listenlater_extension_token_expires_at"
    }
  },
  "runtime": {
    "user": "articlepod",
    "group": "articlepod",
    "appDir": "/opt/articlepod",
    "stagingDir": "/home/azureuser/articlepod",
    "etcDir": "/etc/articlepod",
    "envFile": "/etc/articlepod/articlepod.env",
    "servicePrefix": "articlepod",
    "legacy": {
      "user": "listenlater",
      "group": "listenlater",
      "appDir": "/opt/listenlater",
      "stagingDir": "/home/azureuser/listenlater",
      "etcDir": "/etc/listenlater",
      "envFile": "/etc/listenlater/listenlater.env",
      "servicePrefix": "listenlater"
    }
  },
  "infra": {
    "prefix": "articlepod",
    "postgresAdminLogin": "articlepod_admin",
    "databaseName": "articlepod",
    "blobContainer": "articlepod",
    "azdProjectName": "articlepod"
  }
}
